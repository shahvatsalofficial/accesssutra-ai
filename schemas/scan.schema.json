{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/accesssutra/scan.schema.json",
  "title": "AccessSutra limited static scan",
  "type": "object",
  "required": [
    "schemaVersion",
    "scope",
    "summary",
    "findings",
    "untested",
    "disclaimer"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "source",
        "sha256"
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "detected",
        "requiresReview"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "ruleId",
          "source",
          "kind",
          "remediation"
        ]
      }
    },
    "untested": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disclaimer": {
      "type": "string"
    }
  }
}
